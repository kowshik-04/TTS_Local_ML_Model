# ---------------------------------------------------------------------------
# Local Voice Studio — environment example
# Copy to .env and change every secret. Docker Compose reads .env automatically
# for variable substitution; native scripts and services need to source it with
# `set -a; source .env; set +a`.
# ---------------------------------------------------------------------------

# --- Paths (defaults are relative to the repository) -----------------------
TTS_ROOT=.
TTS_OUTPUT_DIR=./outputs
TTS_VOICES_DIR=./voices
TTS_CACHE_DIR=./cache
TTS_REFERENCE_CACHE_DIR=./cache/references

# --- Inference -------------------------------------------------------------
# auto|cpu|mps|cuda|cuda:0...
TTS_DEVICE=auto
# Default for API requests that omit engine: auto|indicf5|chatterbox.
# auto keeps IndicF5 for Telugu/Tenglish; English needs Chatterbox enabled.
TTS_ENGINE=auto
# quality|balanced|realtime|custom
TTS_PROFILE=quality
TTS_NFE_STEP=32
TTS_CFG_STRENGTH=2.0
TTS_SPEED=1.0
TTS_WARMUP=1
TTS_INFERENCE_THREADS=0
TTS_MAX_TEXT_CHARS=2000
TTS_MAX_CHUNK_BYTES=420
# Aligned reference cap. Do not raise this without re-validating alignment.
TTS_MAX_ALIGNED_REFERENCE_SECONDS=12.0
TTS_MIN_VOICE_SECONDS=3.0

# Output mastering
TTS_TARGET_RMS_DBFS=-20.0
TTS_PEAK_DBFS=-1.5
TTS_HIGHPASS_HZ=55.0
TTS_FADE_MS=8.0
TTS_TAIL_MS=80.0

# Exact-output cache (bytes; 0 disables the size cap but not caching)
TTS_CACHE_ENABLED=1
TTS_CACHE_MAX_BYTES=10737418240

# Optional experimental Chatterbox-Telugu engine (CC-BY-4.0)
TTS_ENABLE_CHATTERBOX=0
TTS_CHATTERBOX_DIR=./experiments/chatterbox_telugu/models/chatterbox-telugu
TTS_CHATTERBOX_MODEL_ID=shankarpandala/chatterbox-telugu
TTS_CHATTERBOX_EXAGGERATION=0.5
TTS_CHATTERBOX_CFG_WEIGHT=0.5
TTS_CHATTERBOX_TEMPERATURE=0.8
TTS_CHATTERBOX_REPETITION_PENALTY=1.2
TTS_CHATTERBOX_MIN_P=0.05
TTS_CHATTERBOX_TOP_P=1.0

# --- HTTP API --------------------------------------------------------------
TTS_API_HOST=127.0.0.1
TTS_API_PORT=8000
TTS_API_DB=./data/accounts.sqlite3
# Optional static key. Prefer SQLite keys created with `python -m api.admin`.
TTS_API_KEY=
TTS_API_REQUIRE_AUTH=1
TTS_API_DEFAULT_MONTHLY_CHARS=100000
TTS_API_DEFAULT_RATE_LIMIT=60
TTS_API_MAX_REQUEST_BYTES=31457280
TTS_API_CORS_ORIGINS=
TTS_API_METRICS=1
TTS_API_QUEUE_TIMEOUT=120
TTS_API_CONCURRENCY=1

# --- Voice agent -----------------------------------------------------------
TTS_ENABLE_AGENT=1
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# Local gatekeeper for the agent WebSocket. Leave empty only on a trusted host.
AGENT_API_KEY=

# STT: local faster-whisper, or any OpenAI-compatible transcription endpoint.
AGENT_STT_PROVIDER=local
AGENT_STT_MODEL=large-v3
AGENT_STT_DEVICE=auto
AGENT_STT_COMPUTE_TYPE=auto
AGENT_STT_LANGUAGE=te
AGENT_STT_BASE_URL=https://api.openai.com/v1
AGENT_STT_API_KEY=

# LLM: any OpenAI-compatible streaming chat endpoint (Ollama, vLLM, hosted).
AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
AGENT_LLM_MODEL=qwen2.5:7b
AGENT_LLM_API_KEY=
AGENT_LLM_TEMPERATURE=0.4
AGENT_LLM_MAX_TOKENS=300
AGENT_SYSTEM_PROMPT=

# TTS API used by the agent. The voice must already be enrolled in that API.
AGENT_TTS_URL=http://127.0.0.1:8000
AGENT_TTS_API_KEY=
# Explicit engine override for agent speech: auto|indicf5|chatterbox.
# auto preserves IndicF5 for Telugu/Tenglish and never falls back on failure.
AGENT_TTS_ENGINE=auto
AGENT_VOICE_ID=

# Server-side VAD and audio streaming
AGENT_VAD_FRAME_MS=20
AGENT_VAD_SPEECH_DBFS=-42.0
AGENT_VAD_SILENCE_MS=650
AGENT_VAD_MIN_SPEECH_MS=250
AGENT_VAD_MAX_UTTERANCE_SECONDS=25.0
AGENT_VAD_PRE_ROLL_MS=200
AGENT_INPUT_SAMPLE_RATE=16000
AGENT_OUTPUT_SAMPLE_RATE=24000
AGENT_MAX_HISTORY_TURNS=8

# Hugging Face access for gated IndicF5 weights / optional models.
HF_TOKEN=
